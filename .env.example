# ─────────────────────────────────────────────────────────────────────────────
# Mi CV con IA — environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and must never reach
# the browser (Azure OpenAI key, Supabase service role key, Amplitude server key).
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---
# ONLINE-ONLY: this app cannot run offline. AI_PROVIDER=mock is rejected at
# startup (see ONLINE_ONLY in lib/env.ts) — you MUST use "azure", which calls the
# real Azure OpenAI API and requires the key + base URL below.
AI_PROVIDER=azure
NODE_ENV=development

# --- Azure OpenAI (server-only) ---
AZURE_OPENAI_API_KEY=
# The **v1** endpoint of your Azure OpenAI resource. The trailing /openai/v1 is
# required: that surface speaks plain OpenAI wire format, so no api-version query
# parameter is needed. Validated at startup in lib/env.ts.
AZURE_OPENAI_BASE_URL=https://<your-resource>.cognitiveservices.azure.com/openai/v1
# The DEPLOYMENT name on that resource (usually named after the model it serves),
# used for adaptive questioning + resume generation. The *-codex models are served
# only on the Responses API, which is what lib/ai/azure-openai-provider.ts calls.
# For a lower-cost deployment, gpt-5-mini / gpt-5-nano already have rates
# configured in lib/ai/pricing.ts.
AZURE_OPENAI_MODEL=gpt-5.3-codex

# --- Supabase ---
# Public values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER-ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics (server-only) ---
# Leave blank to disable analytics (events become no-ops).
AMPLITUDE_API_KEY=

# --- Persistence mode ---
# ONLINE-ONLY: PERSISTENCE=memory is rejected at startup (see ONLINE_ONLY in
# lib/env.ts). You MUST use "supabase" and configure the URL/keys above.
PERSISTENCE=supabase

# --- Branding ---
# Two marketing brands from one build: "rumbo-latino" and "aprende". The brand is
# chosen per request from the request host.
# HOW TO SWITCH: docs/switching-brands.md
#
# Brand used when the host matches NO brand — preview deploys, localhost, and any
# domain not listed in a brand config. Unset => rumbo-latino.
#
#   !! This does NOT override a host a brand already claims. On rumbolatino.com
#   !! the host wins and this is ignored; use BRAND_HOST_OVERRIDES there.
#
# A value that is not a registered brand id fails at startup rather than silently
# serving the fallback. Ids are lowercase and hyphenated.
# DEFAULT_BRAND=rumbo-latino
#
# Point specific hosts at a brand. Comma-separated host=brandId. Consulted BEFORE
# each brand's own hosts list, so this is how you flip a claimed domain.
# BRAND_HOST_OVERRIDES=rumbolatino.com=aprende,www.rumbolatino.com=aprende
#
# For local work, append ?brand=aprende (or ?brand=rumbo-latino) to any URL; the
# choice sticks for the session. ?brand=auto clears it.

# --- Resume guidelines ---
# The AI follows the style/format guidelines in `resume-guidelines.md` (project
# root) when generating and analyzing resumes. Edit that file to change them.
# Optionally point somewhere else:
# RESUME_GUIDELINES_PATH=/absolute/path/to/guidelines.md
